    "decimal.js": "10.6.0",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
